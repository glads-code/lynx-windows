#!/usr/bin/env rc
# Compile Lynx pour Windows x86-64 sur deb, avec tcc seulement : tcc croisé,
# LibreSSL (TLS), PDCurses (console), puis Lynx. Résultat dans dist/lynx/ :
# lynx.exe, lynx.cfg et cert.pem, à copier ensemble sous Windows.
# Usage : ./compiler.rc   (sources téléchargées dans sources/, compilation dans construction/)
flag e +
# Outils GNU du système, pas ceux de 9base : configure, cmake et make en dépendent.
fn tube { s=$status; if(~ $s *[0-9a-zA-Z]*){ echo tube en échec : $s >[1=2]; exit tube }; status='' }
cd `{dirname $0}
racine=`{pwd}
mkdir -p sources construction dist

# Sources : empreintes des archives vérifiées par leur signature GPG
# (LibreSSL : Brent Cook ; zlib : Mark Adler 5ED46A6721D365587791E2AA783FCD8E58BCAFBA ; Lynx : Thomas E. Dickey 19882D92DDA4C400C22C0D56CC2AF4472167BE03).
# tinycc (commit fc1fc50, comme rcsh et wak) et PDCurses (étiquette 3.9) : archives GitHub non signées.
fn source { # nom adresse sha256
	if(! test -f sources/$1){
		curl -A glads-build/1.0 -sSfL -o sources/$1.part $2
		mv sources/$1.part sources/$1
	}
	if(! ~ `{sha256sum sources/$1 | wak '{ print $1 }'} $3){ echo empreinte fausse : sources/$1 >[1=2]; exit empreinte }
	status=''
}
tccv=fc1fc50f7a5b3151a8932e9c2adb784140306db4
source tinycc.tar.gz https://github.com/TinyCC/tinycc/archive/$tccv.tar.gz 0efa580b13489e4c10ef0437c354419912dc09081676f63a642e09e77cba5b9e
source libressl-4.4.1.tar.gz https://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-4.4.1.tar.gz 290cdf1b53c086255dc302f118b98602a444e9ae6d11e9bfdd8c9b1b60aa3a22
source PDCurses-3.9.tar.gz https://github.com/wmcbrine/PDCurses/archive/refs/tags/3.9.tar.gz 590dbe0f5835f66992df096d3602d0271103f90cf8557a5d124f693c2b40d7ec
source zlib-1.4.tar.gz https://zlib.net/zlib-1.4.tar.gz 02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584
source lynx2.9.3.tar.gz https://invisible-island.net/archives/lynx/tarballs/lynx2.9.3.tar.gz 6e99e46980974a6d89eceefbb26ca8c7aa7702b78ecb5bad383b859af225d052

c=$racine/construction
rm -rf $c/*
cd $c
for(a in tinycc libressl-4.4.1 PDCurses-3.9 zlib-1.4 lynx2.9.3) tar -xzf $racine/sources/$a.tar.gz

# 1. tcc croisé (Linux -> Windows x86-64), avec les imports Windows qui lui manquent
cd $c/tinycc-$tccv
./configure --prefix'='$c/tcc >/dev/null
make cross-x86_64-win32 >/dev/null
make install >/dev/null
cp $racine/compat/bcrypt.def $racine/compat/advapi32.def $c/tcc/lib/tcc/win32/lib/
echo InitOnceExecuteOnce >> $c/tcc/lib/tcc/win32/lib/kernel32.def
tcc=$c/tcc/bin/x86_64-win32-tcc
p=$c/prefixe
mkdir -p $p/include $p/lib

# 2. fonctions POSIX absentes du msvcrt (gettimeofday, opendir…)
$tcc -c -o $c/compat.o $racine/compat/compat.c
$tcc -ar rcs $p/lib/libtcccompat.a $c/compat.o

# 3. LibreSSL (bibliothèques statiques, sans assembleur)
cd $c
{
	echo 'set(CMAKE_SYSTEM_NAME Windows)'
	echo 'set(CMAKE_SYSTEM_PROCESSOR AMD64)'
	echo 'set(CMAKE_C_COMPILER '^$tcc^')'
	echo 'set(CMAKE_AR '^$tcc^')'
	echo 'set(CMAKE_C_CREATE_STATIC_LIBRARY "<CMAKE_AR> -ar rcs <TARGET> <LINK_FLAGS> <OBJECTS>")'
	echo 'set(CMAKE_C_STANDARD_LIBRARIES "-L'^$p^'/lib -ltcccompat -lws2_32 -lbcrypt -ladvapi32")'
} > tcc-win.cmake
mkdir ssl
cd ssl
cmake ../libressl-4.4.1 -DCMAKE_TOOLCHAIN_FILE'='$c/tcc-win.cmake -DENABLE_ASM'='OFF -DLIBRESSL_APPS'='OFF -DLIBRESSL_TESTS'='OFF -DBUILD_SHARED_LIBS'='OFF -DCMAKE_BUILD_TYPE'='Release '-DCMAKE_C_FLAGS=-include '^$racine^'/compat/tcc-win-compat.h -I'^$racine^'/compat -Din_addr_t=u_long' > cmake.log
make -j2 > make.log
cp crypto/crypto.lib $p/lib/libcrypto.a
cp ssl/ssl.lib $p/lib/libssl.a
cp -r ../libressl-4.4.1/include/openssl $p/include/

# 4. PDCurses (console Windows, UTF-8)
cd $c/PDCurses-3.9
mkdir o
for(f in pdcurses/*.c wincon/*.c) $tcc -c -O2 -I. -Iwincon -DPDC_WIDE -DPDC_FORCE_UTF8 -DHAVE_NO_INFOEX -o o/`{basename $f .c}^.o $f
$tcc -ar rcs $p/lib/libpdcurses.a o/*.o
cp curses.h panel.h $p/include/

# 4 bis. zlib (pages compressées en gzip ou deflate)
cd $c/zlib-1.4
mkdir o
for(f in adler32 compress crc32 deflate gzclose gzlib gzread gzwrite infback inffast inflate inftrees trees uncompr zutil) $tcc -c -O2 -o o/$f.o $f.c
$tcc -ar rcs $p/lib/libz.a o/*.o
cp zlib.h zconf.h $p/include/

# 5. Lynx
cd $c/lynx2.9.3
patch -p1 -s < $racine/lynx-certfile.patch
cd $c
mkdir lynx
cd lynx
CC=$tcc CPPFLAGS='-I'^$p^'/include -I'^$racine^'/compat -DPDC_WIDE -DPDC_FORCE_UTF8 -DUSE_OPENSSL_INCL' LDFLAGS='-L'^$p^'/lib' LIBS='-lws2_32 -lbcrypt -ladvapi32 -luser32 -ltcccompat' ../lynx2.9.3/configure --host'='x86_64-w64-mingw32 --with-ssl'='$p --with-screen'='pdcurses --disable-nls --disable-idna --enable-widec --with-zlib --without-bzlib > configure.log
if(! grep -q '^#define USE_SSL 1' lynx_cfg.h){ echo configure n''a pas trouvé LibreSSL >[1=2]; exit ssl }
if(! grep -q '^#define USE_ZLIB 1' lynx_cfg.h){ echo configure n''a pas trouvé zlib >[1=2]; exit zlib }
# tcc ne définit pas __MINGW32__ (Lynx s'en sert pour savoir qu'il est sous Windows) ;
# pas d'icône (windres absent)
for(m in makefile src/makefile WWW/Library/Implementation/makefile src/chrtrans/makefile)
	sed 's/^CPPFLAGS	= /CPPFLAGS	= -DHAVE_ALLOCA_H=1 -D__MINGW32__ /' $m > $m.tmp && mv $m.tmp $m
sed 's/ LYIcon\$o / /' src/makefile > src/makefile.tmp && mv src/makefile.tmp src/makefile
make > make.log

# 6. dist/lynx
d=$racine/dist/lynx
rm -rf $d
mkdir -p $d
cp lynx.exe $d/
cp $c/libressl-4.4.1/cert.pem $d/
{ cat $c/lynx2.9.3/lynx.cfg; cat $racine/glads.cfg } > $d/lynx.cfg
sha256sum $d/lynx.exe
echo prêt : $d
